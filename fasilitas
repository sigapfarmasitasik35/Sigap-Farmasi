          <select id="fTipe">
            <option value="puskesmas">Puskesmas</option>
            <option value="rumahsakit">Rumah Sakit</option>
            <option value="posko">Posko Darurat</option>
          </select>
        </div>
        <div class="field"><label>Wilayah</label><input type="text" id="fWilayah" placeholder="Contoh: Cianjur, Jawa Barat"></div>
