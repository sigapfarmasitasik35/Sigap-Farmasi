<script>
  // =========================================================
  // KONEKSI SUPABASE (opsional).
  // Kalau tabel "fasilitas" belum ada di Supabase kamu, halaman ini
  // tetap berjalan memakai DATA CONTOH di bawah (mode demo).
  // Variabel klien diberi nama "db" (bukan "supabase") supaya tidak
  // bentrok dengan variabel global dari library CDN.
  // =========================================================
  const SUPABASE_URL = 'https://liaqekfxhbzewgctvach.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_e8fyvAqH8lwfxUAN03MRLQ_dCABlMId';

  let db;
  try {
    if (window.supabase) {
      db = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }
  } catch (e) {
    console.error('Gagal membuat koneksi Supabase:', e);
  }

  // ---------- Data contoh (dipakai kalau tabel "fasilitas" belum ada) ----------
  let dataFasilitas = [
    { id:'demo-1', nama:'Puskesmas Jakarta Pusat', tipe:'puskesmas', wilayah:'Jakarta', kontak:'021-xxxxxxx', lat:-6.1944, lng:106.8229 },
    { id:'demo-2', nama:'RSUD Surabaya', tipe:'rumahsakit', wilayah:'Surabaya', kontak:'031-xxxxxxx', lat:-7.2575, lng:112.7521 },
    { id:'demo-3', nama:'Posko Darurat Kalimantan', tipe:'posko', wilayah:'Kalimantan', kontak:'-', lat:0.0236, lng:114.7188 }
  ];
  let modeDemo = true;

  const tipeLabel = { puskesmas:'Puskesmas', rumahsakit:'Rumah Sakit', posko:'Posko Darurat' };

  // ---------- Peta ----------
  let peta, markerLayer;
  function initPeta(){
    peta = L.map('peta', { scrollWheelZoom:false }).setView([-2.5, 118], 4.3);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap &copy; CARTO',
      maxZoom: 19
    }).addTo(peta);
    markerLayer = L.layerGroup().addTo(peta);
  }

  function renderMarker(){
    markerLayer.clearLayers();
    dataFasilitas.forEach(f=>{
      if(!f.lat || !f.lng) return;
      const marker = L.marker([f.lat, f.lng]).addTo(markerLayer);
      marker.bindPopup(`<b>${f.nama}</b><br>${tipeLabel[f.tipe] || f.tipe}<br>${f.wilayah || ''}`);
    });
  }

  // ---------- Muat data ----------
  async function loadFasilitas(){
    if(!db){ renderTabel(); renderMarker(); return; }
    try{
      const { data, error } = await db.from('fasilitas').select('*').order('nama', { ascending:true });
      if(error){
        // Tabel belum ada / RLS menolak → tetap pakai data contoh, jangan bikin halaman gagal total
        console.warn('Memakai data contoh (Supabase belum siap):', error.message);
        modeDemo = true;
      } else if (data){
        dataFasilitas = data;
        modeDemo = false;
      }
    }catch(e){
      console.warn('Memakai data contoh (Supabase belum siap):', e);
    }
    renderTabel();
    renderMarker();
  }

  function renderTabel(){
    const tbody = document.getElementById('tabelFasilitas');
    if(dataFasilitas.length === 0){
      tbody.innerHTML = '<tr><td colspan="5" class="empty-msg">Belum ada data fasilitas. Klik "Tambah Fasilitas" untuk menambahkan.</td></tr>';
      return;
    }
    tbody.innerHTML = '';
    dataFasilitas.forEach(f=>{
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="nama-fas">${f.nama}</td>
        <td><span class="tipe-badge ${f.tipe}">${tipeLabel[f.tipe] || f.tipe}</span></td>
        <td>${f.wilayah || '-'}</td>
        <td>${f.kontak || '-'}</td>
        <td class="aksi">
          <button title="Lihat di peta" onclick="fokusPeta(${f.lat}, ${f.lng})">📍</button>
          <button class="del" title="Hapus" onclick="hapusFasilitas('${f.id}')">🗑</button>
        </td>`;
      tbody.appendChild(tr);
    });
  }

  function fokusPeta(lat, lng){
    if(!lat || !lng) return;
    peta.flyTo([lat, lng], 9, { duration: 0.8 });
  }

  // ---------- Tambah ----------
  function tambahFasilitas(){
    document.getElementById('fNama').value = '';
    document.getElementById('fTipe').value = 'puskesmas';
    document.getElementById('fWilayah').value = '';
    document.getElementById('fLat').value = '';
    document.getElementById('fLng').value = '';
    document.getElementById('fKontak').value = '';
    document.getElementById('tambahModal').classList.add('show');
  }
  function tutupModalTambah(){
    document.getElementById('tambahModal').classList.remove('show');
  }

  async function simpanFasilitas(){
    const nama = document.getElementById('fNama').value.trim();
    const tipe = document.getElementById('fTipe').value;
    const wilayah = document.getElementById('fWilayah').value.trim();
    const lat = parseFloat(document.getElementById('fLat').value);
    const lng = parseFloat(document.getElementById('fLng').value);
    const kontak = document.getElementById('fKontak').value.trim();

    if(!nama || !wilayah || isNaN(lat) || isNaN(lng)){
      tampilkanToast('Nama, Wilayah, Latitude, dan Longitude wajib diisi dengan benar.', true);
      return;
    }

    if(db && !modeDemo){
      const { error } = await db.from('fasilitas').insert([{ nama, tipe, wilayah, lat, lng, kontak }]);
      if(error){
        tampilkanToast('Gagal menyimpan ke Supabase: ' + error.message, true);
        return;
      }
      await loadFasilitas();
    } else {
      dataFasilitas.push({ id:'demo-'+Date.now(), nama, tipe, wilayah, lat, lng, kontak });
      renderTabel();
      renderMarker();
    }

    tutupModalTambah();
    tampilkanToast('Fasilitas "' + nama + '" berhasil ditambahkan' + (modeDemo ? ' (mode demo, belum tersimpan permanen).' : '.'));
  }

  async function hapusFasilitas(id){
    const item = dataFasilitas.find(f => String(f.id) === String(id));
    if(!item) return;
    const yakin = confirm('Hapus "' + item.nama + '" dari daftar fasilitas?');
    if(!yakin) return;

    if(db && !modeDemo){
      const { error } = await db.from('fasilitas').delete().eq('id', id);
      if(error){ tampilkanToast('Gagal menghapus: ' + error.message, true); return; }
      await loadFasilitas();
    } else {
      dataFasilitas = dataFasilitas.filter(f => f.id !== id);
      renderTabel();
      renderMarker();
    }
    tampilkanToast('"' + item.nama + '" berhasil dihapus');
  }

  function tampilkanToast(msg, isError){
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast' + (isError ? ' error' : '');
    t.style.display = 'block';
    clearTimeout(window._toastTimer);
    window._toastTimer = setTimeout(()=>{ t.style.display = 'none'; }, 5000);
  }

  // ---------- Mulai ----------
  initPeta();
  loadFasilitas();
</script>
</body>
</html>
