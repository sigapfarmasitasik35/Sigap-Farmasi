<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sigap-Farmasi – Fasilitas Kesehatan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --bg:#0b0f10;
    --panel:#12181a;
    --panel-2:#161d1f;
    --border:#242c2e;
    --green:#1fae76;
    --green-soft:#153627;
    --red:#e5484d;
    --red-soft:#3a1f21;
    --orange:#f5a524;
    --orange-soft:#3a2c14;
    --text:#f2f4f3;
    --text-dim:#93a1a0;
    --text-faint:#5c6b6a;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    display:flex;
    height:100vh;
    overflow:hidden;
  }
  h1,h2,.brand{font-family:'Space Grotesk',sans-serif;}

  /* ---------- Sidebar (sama seperti halaman lain) ---------- */
  .sidebar{
    width:240px;flex-shrink:0;background:var(--panel);
    border-right:1px solid var(--border);padding:16px 12px;
    display:flex;flex-direction:column;gap:16px;
    height:100vh;overflow-y:auto;
  }
  .brand{display:flex;align-items:center;gap:9px;font-size:17px;font-weight:700;padding:0 6px;}
  .brand-icon{width:28px;height:28px;border-radius:7px;background:var(--green-soft);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
  .menu-label{font-size:10px;letter-spacing:.08em;color:var(--text-faint);text-transform:uppercase;padding:0 10px;margin-bottom:5px;}
  nav ul{list-style:none;display:flex;flex-direction:column;gap:1px;}
  nav a{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:7px;color:var(--text-dim);text-decoration:none;font-size:13px;font-weight:500;transition:background .15s, color .15s; white-space:nowrap;}
  nav a:hover{background:var(--panel-2);color:var(--text);}
  nav a.active{background:var(--green-soft);color:var(--green);}
  nav a svg{width:16px;height:16px;flex-shrink:0;}

  /* ---------- Main ---------- */
  .main{
    flex:1;padding:14px 22px;min-width:0;
    height:100vh; display:flex; flex-direction:column; overflow:hidden;
  }

  .topbar{display:flex;align-items:center;gap:14px;margin-bottom:12px;flex-shrink:0;}
  .menu-toggle{
    display:none;width:34px;height:34px;flex-shrink:0;align-items:center;justify-content:center;
    background:var(--panel);border:1px solid var(--border);border-radius:8px;color:var(--text-dim);cursor:pointer;
  }
  .search-top{
    flex:1;display:flex;align-items:center;gap:9px;background:var(--panel);
    border:1px solid var(--border);border-radius:9px;padding:8px 12px;color:var(--text-faint);
    max-width:480px; min-width:0;
  }
  .search-top input{background:none;border:none;outline:none;color:var(--text);font-size:13.5px;width:100%;min-width:0;}
  .avatar{
    width:34px;height:34px;border-radius:9px;background:var(--green);color:#0b0f10;font-weight:700;
    font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-left:auto;
  }

  .page-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;flex-wrap:wrap;gap:14px;flex-shrink:0;}
  .page-header h1{font-size:20px;font-weight:700;margin-bottom:3px;}
  .page-header p{color:var(--text-dim);font-size:12.5px;}

  .btn-primary{display:flex;align-items:center;gap:7px;background:var(--green);color:#0b0f10;border:none;padding:9px 15px;border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;}
  .btn-primary:hover{opacity:.9;}
  .btn-secondary{display:flex;align-items:center;gap:8px;background:var(--panel-2);color:var(--text);border:1px solid var(--border);padding:9px 14px;border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;}
  .btn-secondary:hover{border-color:var(--text-faint);}

  /* ---------- Konten: peta + daftar, scroll internal saja ---------- */
  .content{flex:1; min-height:0; overflow-y:auto; display:flex; flex-direction:column; gap:14px;}

  .map-panel{
    background:var(--panel);border:1px solid var(--border);border-radius:12px;
    padding:14px; flex-shrink:0;
  }
  .map-panel-title{
    display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600;margin-bottom:12px;color:var(--text);
  }
  .map-panel-title svg{width:16px;height:16px;color:var(--green);flex-shrink:0;}
  #peta{
    height:400px;border-radius:9px;overflow:hidden;background:#1a2c34;
  }
  .leaflet-popup-content-wrapper{background:var(--panel-2);color:var(--text);border-radius:8px;}
  .leaflet-popup-tip{background:var(--panel-2);}
  .leaflet-popup-content b{color:var(--green);}
  .leaflet-container a.leaflet-popup-close-button{color:var(--text-dim);}

  /* ---------- Tabel daftar fasilitas ---------- */
  .table-wrap{
    background:var(--panel);border:1px solid var(--border);border-radius:12px;
    overflow:auto; flex-shrink:0;
  }
  table{width:100%;min-width:760px;border-collapse:collapse;}
  thead th{
    text-align:left;font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--text-faint);
    padding:10px 16px;border-bottom:1px solid var(--border); white-space:nowrap;
    position:sticky; top:0; background:var(--panel); z-index:1;
  }
  tbody td{padding:10px 16px;border-bottom:1px solid var(--border);font-size:12.5px;vertical-align:middle; white-space:nowrap;}
  tbody tr:last-child td{border-bottom:none;}
  tbody tr:hover{background:var(--panel-2);}
  .nama-fas{color:var(--green);font-weight:600;}
  .tipe-badge{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px;}
  .tipe-badge.puskesmas{background:var(--green-soft);color:var(--green);}
  .tipe-badge.rumahsakit{background:var(--orange-soft);color:var(--orange);}
  .tipe-badge.posko{background:var(--red-soft);color:var(--red);}
  .empty-msg{color:var(--text-faint);font-size:13px;text-align:center;padding:28px 12px;white-space:normal;}

  .aksi{display:flex;gap:6px;}
  .aksi button{width:26px;height:26px;border-radius:6px;border:1px solid var(--border);background:var(--panel-2);color:var(--text-dim);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;font-size:12px;}
  .aksi button:hover{color:var(--text);border-color:var(--text-faint);}
  .aksi button.del:hover{color:var(--red);border-color:var(--red);}

  /* ---------- Modal tambah ---------- */
  .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:50;align-items:center;justify-content:center;padding:20px;}
  .modal-overlay.show{display:flex;}
  .modal-box{background:var(--panel);border:1px solid var(--border);border-radius:14px;width:100%;max-width:440px;padding:24px;max-height:90vh;overflow-y:auto;}
  .modal-box h3{font-size:18px;font-weight:700;margin-bottom:18px;}
  .field{margin-bottom:14px;}
  .field label{display:block;font-size:12px;color:var(--text-dim);margin-bottom:6px;}
  .field input,.field select{width:100%;background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;color:var(--text);font-size:14px;outline:none;}
  .field input:focus,.field select:focus{border-color:var(--green);}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .field-hint{font-size:11.5px;color:var(--text-faint);margin-top:5px;}
  .modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px;}

  .toast{position:fixed;bottom:24px;right:24px;background:var(--green);color:#06110c;font-weight:600;font-size:14px;padding:12px 18px;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.4);display:none;z-index:60;max-width:360px;}
  .toast.error{background:var(--red);color:#fff;}

  @media (max-width:900px){
    .sidebar{display:none;}
    .main{padding:14px;}
    .menu-toggle{display:flex;}
    #peta{height:300px;}
  }
</style>
</head>
